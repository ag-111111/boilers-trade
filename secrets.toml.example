# Copy to .streamlit/secrets.toml (never commit it). With these set, signups
# must enter a 6 digit code sent to their @purdue.edu inbox.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "yourbot@gmail.com"
SMTP_PASS = "your-16-char-app-password"
SMTP_FROM = "Boilers Trade <yourbot@gmail.com>"
